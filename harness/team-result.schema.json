{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {"type": "string"},
          "body": {"type": "string"},
          "deps": {"type": "array", "items": {"type": "integer", "minimum": 1}},
          "priority": {"type": "string", "enum": ["high", "normal", "low"]}
        }
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "verdict", "body"],
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "verdict": {"type": "string", "enum": ["approve", "reject", "abstain"]},
          "body": {"type": "string"}
        }
      }
    },
    "report": {"type": "string"}
  }
}
